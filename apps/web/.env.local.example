# Copy to .env.local (gitignored). No secrets / demo passwords in NEXT_PUBLIC_* (CLAUDE §6.4).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side API base used by NextAuth + route handlers (falls back to NEXT_PUBLIC_API_URL)
API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-dev-only
NEXT_PUBLIC_DEMO_MODE=true
