# Aureon Demo — environment template (07 §7).
# Copy to .env and replace every <change-me>. Never commit .env.

# --- Database (api, worker) ---
POSTGRES_USER=aureon
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=aureon
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aureon:<change-me>@localhost:5432/aureon

# --- Redis / Celery (api, worker) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Outbox relay tick in seconds (07 §3, beat x1)
OUTBOX_RELAY_INTERVAL_SECONDS=2

# --- Storage: MinIO in dev, S3 in prod (api, worker) ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=<change-me>
S3_SECRET_KEY=<change-me>
S3_BUCKET=source-documents

# --- Auth (web, api) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<change-me>
# JWT RS256 (DEC-129). Keys: scripts/generate_keys.sh -> ./secrets (gitignored).
# Alternatively set JWT_PRIVATE_KEY / JWT_PUBLIC_KEY to a PEM string or base64-encoded PEM.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=aureon-2026-10
JWT_ISSUER=aureon
JWT_AUDIENCE=aureon-api
# Access 15 min, refresh 7 days, rotated (CLAUDE.md §5.3).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_LEEWAY_SECONDS=30
# Temporary lock after N consecutive failed logins (02 §4).
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# --- Model gateway (api, worker) ---
# MODEL_GATEWAY_MODE controls where AI classification/extraction runs:
#   fixture = replay 7 recorded demo documents, NO real AI, no key needed (default).
#   live    = call a real OpenAI-compatible LLM gateway at OMNIROUTE_BASE_URL.
# To TEST REAL AI, set MODEL_GATEWAY_MODE=live and point OMNIROUTE_* at your gateway.
# OMNIROUTE_BASE_URL must expose POST {base}/chat/completions (OpenAI-compatible).
# OMNIROUTE_API_KEY is sent as `Authorization: Bearer <key>`.
# See docs/3.EXECUTION/15-AI-KEY-SETUP.md for the step-by-step guide.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=<change-me>
MODEL_CLASSIFY=agent-free-cheap
MODEL_EXTRACT=agent-coding
MODEL_GATEWAY_MODE=fixture

# --- v2 multi-provider ModelGateway (DEC-131, 07 §7) — placeholders only ---
# `app.core.model_gateway` (T-013). A cloud provider without an API key is skipped from the chain.
# Supported providers: omniroute | openrouter | 9router (= ninerouter) | deepseek | openai | anthropic
# Per-provider model alias: MODEL_<TASK>__<PROVIDER>=... (e.g. MODEL_CHAT__ANTHROPIC=claude-...)
MODEL_PROVIDER_PRIMARY=omniroute
MODEL_PROVIDER_FALLBACKS=openrouter,deepseek
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=<change-me>
NINEROUTER_BASE_URL=http://localhost:20129/v1
NINEROUTER_API_KEY=<change-me>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=<change-me>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=<change-me>
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=<change-me>
MODEL_CHAT=auto/coding
MODEL_CLASSIFY=auto/cheap
MODEL_EXTRACT=auto/coding
MODEL_MAPPING=auto/cheap
MODEL_INSIGHT=auto/cheap
MODEL_STT=fixture/stt
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=2048
# USD per 1M tokens by provider:model — {"openrouter:auto/coding": {"in": 3, "out": 15}}
MODEL_PRICING_JSON={}
AI_TURN_TIMEOUT_SEC=30
# T-509 / DEC-241 — chat-only model chain inside each cloud provider (primary → fallback,
# one attempt each) + per-call chat timeout. Empty → MODEL_CHAT. OmniRoute ids need a prefix.
CHAT_MODEL_PRIMARY=cc/claude-sonnet-5
CHAT_MODEL_FALLBACK=cl/deepseek/deepseek-v4.1-flash
CHAT_TIMEOUT_SECONDS=90
# Demo replay of 10 recorded questions (apps/api/src/app/modules/ai/demo_responses.json);
# unset → follows DEMO_MODE. Token pacing for the replay stream, seconds.
# AI_DEMO_REPLAY=true
AI_DEMO_TOKEN_DELAY_SEC=0.03
AI_RATE_LIMIT_PER_MIN=20
AI_MONTHLY_BUDGET_USD=50
AI_BUDGET_ALERT_PCT=80

# --- OCR (worker) ---
OCR_PROVIDER=paddle

# --- Limits (api) ---
MAX_FILE_SIZE_MB=20
MAX_PAGES=50

# --- Demo (08 §2) ---
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
# T-604 (R-DEC-25): web BFF data source — real (FastAPI) | mock (in-process fixtures from
# apps/web/src/mocks/seed_snapshot.json, no backend). Server env only; mock is refused when
# NODE_ENV=production. MOCK_LOGIN_PASSWORD (optional) = the one password accepted in mock mode.
API_MODE=real
MOCK_LOGIN_PASSWORD=
DEMO_REFERENCE_DATE=2026-10-20
# pgcrypto key for level-4 PII columns (NĐ 13/2023; T-234). 32-byte hex:
#   python -c "import secrets; print(secrets.token_hex(32))"   — never commit the real value
DB_ENCRYPTION_KEY=<change-me-64-hex>
# METRIC-HR-01 plan, VND / person / year (08 §6)
HR_REVENUE_PER_HEAD_PLAN=2000000000
# One password per demo account (08 §2) — seed stores only the argon2 hash. An account whose
# password is unset is skipped by `uv run python -m app.seed`. DEMO_PASSWORD = fallback for all.
# v1 names DEMO_SALES_PASSWORD / DEMO_HR_PASSWORD are still accepted.
DEMO_PASSWORD=
DEMO_CEO_PASSWORD=<change-me>
DEMO_CFO_PASSWORD=<change-me>
DEMO_VP_SALES_PASSWORD=<change-me>
DEMO_HR_MANAGER_PASSWORD=<change-me>
DEMO_REVIEWER_PASSWORD=<change-me>
# CPO + RISK_MANAGER own the product / risk demo data (T-237). Either the DEMO_* name or the
# SEED_PASSWORD_* alias below sets them; set at least one so the seed creates all 7 F.O.C.U.S users.
DEMO_CPO_PASSWORD=<change-me>
DEMO_RISK_MANAGER_PASSWORD=<change-me>
SEED_PASSWORD_CPO=<change-me>
SEED_PASSWORD_RISK_MANAGER=<change-me>
DEMO_MANAGER_PASSWORD=<change-me>
DEMO_OFFICE_MANAGER_PASSWORD=<change-me>
DEMO_EMPLOYEE_PASSWORD=<change-me>
DEMO_ADMIN_PASSWORD=<change-me>

# --- Frontend -> API ---
API_BASE_URL=http://localhost:4000/api/v1

# Demo quick-login (SCR-13): the button sends only the e-mail + a `demo` flag; NextAuth resolves
# the password server-side from DEMO_*_PASSWORD above. Never put a password in NEXT_PUBLIC_*
# (CLAUDE §5.8, §6.4) — the browser must never receive one.

# --- v2.1 (07 §7 "mới 2.1", T-002) — placeholders / defaults only ---
# Approval: finance requests >= threshold need 2 approvers (DEC-155).
APPROVAL_FINANCE_THRESHOLD_VND=500000000
# Daily briefing, Asia/Ho_Chi_Minh (03 §7.2).
BRIEFING_TIME=06:00
# METRIC-DQ-01 weights — must sum to 1.0, app fails fast otherwise (03 §2.6).
DQ_WEIGHT_COMPLETENESS=0.3
DQ_WEIGHT_ACCURACY=0.4
DQ_WEIGHT_FRESHNESS=0.3
# Provider routing by data_classification (DEC-157, 07 §6.5): CONFIDENTIAL -> local, SECRET -> no LLM.
MODEL_PROVIDER_CONFIDENTIAL=ollama
MODEL_PROVIDER_SECRET=none
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
# bge-m3 is EMBEDDING ONLY — never set it as the chat model (DEC-142).
LOCAL_CHAT_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=bge-m3
# Operational Freshness SLA — "stale data" badge on dashboard metrics (DEC-158, 03 §1.3).
SLA_OPERATIONAL_EXECUTION_HOURS=1
SLA_OPERATIONAL_SALES_HOURS=1
SLA_OPERATIONAL_FINANCE_HOURS=4
SLA_OPERATIONAL_RISK_HOURS=4
SLA_OPERATIONAL_HR_HOURS=24
SLA_OPERATIONAL_PRODUCT_HOURS=24
# Data Quality Freshness SLA — `freshness` component of METRIC-DQ-01 (DEC-158, 03 §2.6).
SLA_FRESHNESS_FINANCE_HOURS=24
SLA_FRESHNESS_SALES_HOURS=24
SLA_FRESHNESS_HR_HOURS=72
SLA_FRESHNESS_PRODUCT_HOURS=72
SLA_FRESHNESS_RISK_HOURS=48
SLA_FRESHNESS_EXECUTION_HOURS=24
# ClamAV malware scan (DEC-138). Demo: scanner down -> SKIPPED + no STP.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
